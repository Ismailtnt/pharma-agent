# --- Option A: OpenAI / LiteLLM proxy (default) ---
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://your-litellm-proxy/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Option B: Groq (comment out Option A, or set LLM_PROVIDER=groq) ---
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b
# LLM_PROVIDER=groq

# Optional: "local" = TF-IDF similarity in numpy (default with Groq, which has no embeddings API)
# EMBEDDING_PROVIDER=local

# No quotes around values: docker --env-file passes them literally.
